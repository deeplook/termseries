# termseries.mplstyle — example style for termseries.py
#
# Load with:  plt.style.use("./termseries.mplstyle")
# Compose with dark/light base:
#   plt.style.use(["dark_background", "./termseries.mplstyle"])
#
# See all available keys:
#   https://matplotlib.org/stable/users/explain/customizing.html

# --- Lines -----------------------------------------------------------
lines.linewidth:  2
lines.marker:     o
lines.markersize: 6

# --- Axes -------------------------------------------------------------
axes.grid:        True
axes.titlesize:   14
axes.labelsize:   12

# --- Grid -------------------------------------------------------------
grid.alpha:       0.3
grid.linewidth:   0.5
grid.linestyle:   -

# --- Legend ------------------------------------------------------------
legend.loc:       best
legend.fontsize:  10
legend.framealpha: 0.8

# --- Ticks -------------------------------------------------------------
xtick.labelsize:  10
ytick.labelsize:  10

# --- Figure ------------------------------------------------------------
figure.dpi:       200
figure.constrained_layout.use: True

# --- Color cycle (tab10 palette) --------------------------------------
axes.prop_cycle: cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2', '7f7f7f', 'bcbd22', '17becf'])

# --- Dark theme overrides (uncomment if not composing with dark_background)
# figure.facecolor: black
# axes.facecolor:   black
# text.color:       white
# axes.labelcolor:  white
# xtick.color:      white
# ytick.color:      white
