# termseries configuration
# Copy to .termseries.env in your project directory or
# ~/.config/termseries/termseries.env for user-global settings.

# Plot theme: dark, light, or auto (default — follows terminal background)
# THEME=auto

# Output destination: auto (default), inline, - (raw stdout), or a file path
# OUTPUT=auto

# Inline graphics protocol: auto (default), kitty, iterm2, or sixel
# Useful when terminal detection fails (e.g. inside tmux wrapping iTerm2/Kitty)
# PROTOCOL=auto
